# MQTT 镜像：aedes（生产加固版，env 校验账号口令）
# 构建上下文：services/   dockerfile：Dockerfile.mqtt
FROM node:20-slim

WORKDIR /app

# 仅安装 aedes（MQTT broker 依赖）；net 为 Node 内置模块，无需安装
# 使用国内 npm 镜像（node 镜像自带 CA，https 可用），避免 registry.npmjs.org 超时
RUN npm init -y >/dev/null 2>&1 || true \
 && npm install aedes@^0.51.3 --registry=https://registry.npmmirror.com --omit=dev --no-audit --no-fund

COPY mqtt-broker.js ./

# 账号口令由 deploy/.env 注入；留空则退回放行任意凭证（本地联调兼容）
ENV MQTT_PORT=1883 \
    MQTT_USERNAME="" \
    MQTT_PASSWORD=""

EXPOSE 1883

ENTRYPOINT ["node", "mqtt-broker.js"]
