# 流媒体镜像：node-media-server + ffmpeg（HLS 切片必需）
# 构建上下文：services/   dockerfile：Dockerfile.media
FROM node:20-slim

WORKDIR /app

# 安装 ffmpeg（HLS 兜底所需）；node:20-slim 无 ca-certificates，
# 故 apt 源必须用 http（阿里云 http 源无需证书校验），否则 https 会报证书校验失败
RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g; s|http://security.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 仅安装流媒体服务依赖（net 为 Node 内置模块，无需安装）
RUN npm init -y >/dev/null 2>&1 || true \
 && npm install node-media-server@^2.7.4 --omit=dev --no-audit --no-fund

COPY media-server.js ./

# HLS 切片输出目录：由 compose 的 dji_hls 卷挂载，保证容器内可写
RUN mkdir -p /app/media
VOLUME ["/app/media"]

ENV RTMP_PORT=1935 \
    MEDIA_HTTP_PORT=8000 \
    MEDIA_ROOT=/app/media \
    FFMPEG_PATH=ffmpeg

EXPOSE 1935 8000

ENTRYPOINT ["node", "media-server.js"]
