# ============================================================
#  air-matrix · 部署环境变量模板（脱敏）
#  用法：cp deploy/.env.example deploy/.env，然后填入真实值。
#  ⛔ deploy/.env 含真实密钥，已被 .gitignore 忽略，禁止提交。
#  运行脚本（up.sh / deploy.sh）会自动 source 本文件。
# ============================================================

# ---- 域名（公网，A 记录指向腾讯云 1.13.24.81） ----
DOMAIN=air-matrix.crmappai.xyz

# ---- PostgreSQL（业务库，仅内网 5432） ----
# 角色由官方 postgres 镜像据此创建；init.sql 预建 dji_admin / dji_log 两库。
POSTGRES_USER=dji
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ---- MinIO（对象存储，仅内网 9000；9001 控制台不暴露） ----
# MINIO_ROOT_USER/PASSWORD 为 MinIO 管理员（root）账号。
MINIO_ROOT_USER=DJICLOUD
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
# 上传专用子账号（由 deploy/minio/init.sh 创建，仅限 dji-media 读写）
MINIO_ACCESS_KEY=djicloud
MINIO_SECRET_KEY=CHANGE_ME_minio_djicloud_secret

# ---- MQTT（aedes，公网 1883；与 Dji.json -> Mqtt.Username/Password 必须一致） ----
MQTT_USERNAME=CHANGE_ME_mqtt_username
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# ---- JWT 签名（64 位十六进制随机串；与 deploy/config/JWT.json 的 IssuerSigningKey 一致） ----
JWT_SIGNING_KEY=CHANGE_ME_64_hex_jwt_signing_key

# ---- 国密 SM2 密钥对（openssl 生成；公钥用于前端与后端，私钥仅后端，严禁泄露） ----
# 公钥：与 dji_vue/.env.production 的 VITE_SM2_PUBLIC_KEY 完全一致。
SM2_PUBLIC_KEY=CHANGE_ME_sm2_public_key_hex
# 私钥：仅填入 deploy/config/App.json 的 Cryptogram.PrivateKey，绝不入库。
SM2_PRIVATE_KEY=CHANGE_ME_sm2_private_key_hex

# ---- 大疆开发者三件套（https://developer.dji.com/user/apps/） ----
DJI_APP_ID=CHANGE_ME_dji_app_id
DJI_APP_KEY=CHANGE_ME_dji_app_key
DJI_APP_LICENSE=CHANGE_ME_dji_app_license

# ---- 对象存储对外公开基址（机场直传 {base}/{bucket}/{key}） ----
# 必须与 deploy/config/Upload.json 的 OSSProvider.PublicBaseUrl 一致；
# 不要带 /minio 前缀（nginx 会改写路径，导致 SigV4 403）。
PUBLIC_BASE_URL=https://air-matrix.crmappai.xyz
