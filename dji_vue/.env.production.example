# ============================================================
#  air-matrix · 前端生产环境变量模板（脱敏）
#  用法：cp dji_vue/.env.production.example dji_vue/.env.production 并填真实值。
#  ⛔ dji_vue/.env.production 已被根 .gitignore 忽略，禁止提交。
# ============================================================

# 线上环境
ENV = production

# 线上环境接口地址（留空 = 同源，由 nginx 反代 /api /kapi /hubs /net /upload）
VITE_API_URL =

# 登录密码 SM2 国密加密公钥（必须与后端 App.json 的 Cryptogram.PublicKey 完全一致；
# 一般为 04 开头的 130 位十六进制串，与 deploy/.env 的 SM2_PUBLIC_KEY 同源）
VITE_SM2_PUBLIC_KEY = CHANGE_ME_sm2_public_key_hex

# 前端资源公共路径（与 nginx root /usr/share/nginx/html 对应）
VITE_PUBLIC_PATH = /

# 端口（HTTPS 443，仅作构建期占位；实际端口由 nginx 监听）
VITE_PORT = 443

# 是否启用公共 CDN（本项目自托管资源，置 false）
VITE_OPEN_CDN = false
