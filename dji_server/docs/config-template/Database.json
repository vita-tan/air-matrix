{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  // 具体配置见SqlSugar官网（第一个为默认库不需要设置ConfigId）
  // ⛔ 本文件为脱敏模板，真实值（库密码）请在 deploy/config/Database.json 中填写，禁止提交。
  // 【v2.1 变更】数据库已由 SQLite 迁移至 PostgreSQL 16：DbType 改为 PostgreSQL，
  //   连接串使用 Npgsql 格式；两个库 dji_admin(主库) / dji_log(日志库) 由
  //   deploy/postgres/init.sql（postgres 容器首次启动）预建，后端仅做 CodeFirst 建表。
  "DbConnection": {
    "EnableConsoleSql": true, // 启用控制台打印SQL
    "ConnectionConfigs": [
      {
        "ConfigId": "1300000000001", // 默认库标识-禁止修改
        "DbType": "PostgreSQL", // MySql、SqlServer、Sqlite、Oracle、PostgreSQL、MySqlConnector ...
        // Npgsql 连接串（占位账号密码，部署时替换为 deploy/.env 中的 POSTGRES_USER/POSTGRES_PASSWORD）
        // Host 使用 compose 内网服务名 air-matrix-postgres；5432 仅内网，不映射公网。
        "ConnectionString": "Host=air-matrix-postgres;Port=5432;Database=dji_admin;Username=dji;Password=<POSTGRES_PASSWORD>;Pooling=true;SSL Mode=Prefer;Trust Server Certificate=true;",
        "DbSettings": {
          "EnableInitDb": true, // 启用库初始化（PostgreSQL 下仅做 CodeFirst，库已由 init.sql 预建，见 SqlSugarSetup）
          "EnableDiffLog": false, // 启用库表差异日志
          "EnableUnderLine": true // 启用驼峰转下划线
        },
        "TableSettings": {
          "EnableInitTable": true, // 启用表初始化
          "EnableIncreTable": false // 启用表增量更新 启用表增量更新-特性[IncreTable]
        },
        "SeedSettings": {
          "EnableInitSeed": true, // 启用种子初始化
          "EnableIncreSeed": false // 启用种子增量更新 种子增量更新-特性[IncreSeed]
        }
      },
      // 日志独立数据库配置
      {
        "ConfigId": "1300000000002", // 日志库标识-禁止修改
        "DbType": "PostgreSQL",
        "ConnectionString": "Host=air-matrix-postgres;Port=5432;Database=dji_log;Username=dji;Password=<POSTGRES_PASSWORD>;Pooling=true;SSL Mode=Prefer;Trust Server Certificate=true;",
        "DbSettings": {
          "EnableInitDb": true, // 启用库初始化
          "EnableDiffLog": false, // 启用库表差异日志
          "EnableUnderLine": true // 启用驼峰转下划线
        },
        "TableSettings": {
          "EnableInitTable": true, // 启用表初始化
          "EnableIncreTable": false // 启用表增量更新-特性[IncreTable]
        },
        "SeedSettings": {
          "EnableInitSeed": true, // 启用种子初始化
          "EnableIncreSeed": false // 启用种子增量更新-特性[IncreSeed]
        }
      }
    ]
  }
}
