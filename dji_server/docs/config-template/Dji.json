{
  "Dji": {
    "//": "以下参数会通过 MQTT 的 config 应答下发给机场，地址必须是【机场侧可达】的地址，不能用 localhost",
    "AppId": "<DJI_APP_ID>", // 大疆开发者 App ID，https://developer.dji.com/user/apps/
    "AppKey": "<DJI_APP_KEY>", // 大疆开发者 App Key
    "AppLicense": "<DJI_APP_LICENSE>", // 大疆开发者 App License
    "NtpServerHost": "ntp.aliyun.com", // NTP 服务器地址；机场与云端时钟偏差过大会导致立即任务（30s 容差）被拒绝
    "NtpServerPort": 123, // NTP 服务端口
    "FileBaseUrl": "https://air-matrix.crmappai.xyz", // KMZ 对外访问前缀（公网 HTTPS，与 nginx 同源）
    "Live": {
      "//": "自建 node-media-server。RtmpPushBaseUrl 由【机场】访问（推流，公网 1935），Flv/Hls 由【浏览器】访问（拉流，经 nginx /live）",
      "Enabled": true, // 置为 true 后才允许开播；否则开播接口直接返回「未配置」
      "RtmpPushBaseUrl": "rtmp://air-matrix.crmappai.xyz:1935/live", // 机场推流入口（公网 1935，安全组放行）
      "FlvPlayBaseUrl": "https://air-matrix.crmappai.xyz/live", // 浏览器 HTTP-FLV 出口（经 nginx /live 反代，HTTPS）
      "HlsPlayBaseUrl": "https://air-matrix.crmappai.xyz/live", // 浏览器 HLS 出口（经 nginx /live 反代，HTTPS）
      "StreamPrefix": "dji_", // 流名前缀，用于区分大疆的流与其他业务的流
      "MaxConcurrentPerDock": 1, // 单机场并发路数兜底值；设备上报 live_capacity 后以设备为准
      "MaxSessionMinutes": 120 // 单次直播最长时长（分钟），超时自动停播；0 表示不限制
    }
  },
  "Mqtt": {
    "ClientId": "webapp_client_01",
    "Server": "air-matrix-mqtt", // ⛔ 后端容器内【内网】服务名；机场侧填公网 air-matrix.crmappai.xyz:1883
    "Port": 1883,
    "UseTls": false, // 内网明文；公网 1883 由安全组 + aedes env 账号口令加固
    "Username": "<MQTT_USERNAME>", // 与 services/mqtt-broker.js 的 MQTT_USERNAME 一致（来自 deploy/.env）
    "Password": "<MQTT_PASSWORD>", // ⛔ 真实值来自 deploy/.env
    "KeepAliveSeconds": 60,
    "CleanSession": true,
    "SubscribedTopics": [
      "sys/product/+/status",
      "thing/product/+/osd",
      "thing/product/+/state",
      "thing/product/+/requests",
      "thing/product/+/requests_reply",
      "thing/product/+/services_reply",
      "thing/product/+/property/set_reply",
      "thing/product/+/events",
      "thing/product/+/drc/up"
    ]
  }
}
